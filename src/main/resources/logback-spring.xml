<?xml version="1.0" encoding="UTF-8"?>
<!--
    Story 1.3 — Structured logging + secrets sanitiser.

    - ConsoleAppender → System.err (stdout is reserved for MCP JSON-RPC transport per ARCH-21).
    - JSON output via logstash-logback-encoder 9.0 (Logback 1.5.x has no native JSON encoder).
    - SanitisingLayout wraps the JSON layout, redacting JWTs, Bearer tokens, base64 blobs,
      the literal TWINS_M2M_CLIENT_SECRET, and the live AuthToken (registered by Story 1.4).

    Spring Boot's defaults.xml is intentionally NOT included — its default console appender
    writes to stdout, which would corrupt the JSON-RPC channel.
-->
<configuration>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <immediateFlush>true</immediateFlush>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.twins.mcp.secrets.SanitisingLayout">
                <delegate class="net.logstash.logback.layout.LogstashLayout">
                    <includeContext>false</includeContext>
                    <includeMdc>true</includeMdc>
                    <includeStructuredArguments>true</includeStructuredArguments>
                </delegate>
            </layout>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>

</configuration>
